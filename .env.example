# ==========================================
# SRM eCurricula Worksheet Automator Environment Variables
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
API_V1_STR=/api/v1
PROJECT_NAME="SRM Automator"

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/srm_automator
DATABASE_ECHO=False

# Redis & Celery Background Worker Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SRM Portal Settings
SRM_BASE_URL=https://dld.srmist.edu.in
SRM_STATIC_KEY=john
SRM_REQUEST_TIMEOUT_SECONDS=30
SRM_HEADLESS_BROWSER=True
SRM_PREFER_HTTP=True
SRM_BROWSER_DOWNLOAD_DIR=artifacts/downloads
SRM_ARTIFACTS_DIR=artifacts/browser

# Optional Local Developer Testing Credentials (never commit real values)
SRM_STUDENT_ID=
SRM_STUDENT_PASSWORD=
SRM_CAPTCHA_CODE=

# Google Drive Integration (OAuth 2.0 User Authorization)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# AI Answer Engine Configuration (Primary: NVIDIA, Fallback: FreeLLM)
WORKSHEET_ANSWER_PROVIDER=nvidia
AI_FALLBACK_PROVIDER=freellm
AI_PROVIDER_ORDER=nvidia,freellm

# NVIDIA API (Primary Provider)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b,meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY=
NVIDIA_TIMEOUT_SECONDS=60.0
NVIDIA_MAX_RETRIES=3
NVIDIA_RETRY_BACKOFF_SECONDS=2.0
NVIDIA_CIRCUIT_BREAKER_FAILURES=3
NVIDIA_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# FreeLLM API (Fallback Provider)
FREELLM_BASE_URL=http://127.0.0.1:31415/v1
FREELLM_MODEL=default
FREELLM_API_KEY=
FREELLM_TIMEOUT_SECONDS=60.0
FREELLM_MAX_RETRIES=2
FREELLM_RETRY_BACKOFF_SECONDS=2.0

# Batch Sizes & Chunking
NVIDIA_BATCH_SIZE=4
FREELLM_BATCH_SIZE=4
WORKSHEET_CHUNK_SIZE=4

